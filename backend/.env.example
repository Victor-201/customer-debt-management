# ══════════════════════════════════════════════════════════════════════
# customer-debt-management — Backend Environment Variables
# Standard: devops.skill.md Section 3.8
#
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env with real values — it is gitignored.
# Populate GitHub Actions secrets and Render Environment Group
# with these same keys for CI/CD and production runtime.
# ══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL via Neon in production) ──────────────────────
# Production: use DATABASE_URL (connection string from Neon dashboard)
# Local: use individual vars below
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=customer_debt_db

# ── JWT ───────────────────────────────────────────────────────────────
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_min_32_char_random_string
JWT_REFRESH_SECRET=replace_with_different_min_32_char_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=customer-debt-management
JWT_AUDIENCE=customer-debt-management-users

# ── Password Hashing ──────────────────────────────────────────────────
SALT_ROUNDS=12

# ── Email / SMTP ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=Customer Debt Management
